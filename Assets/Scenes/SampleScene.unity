    instruction: "\xA1Prende el fuego para el arroz y la carne! El arroz tomar\xE1
      15 minutos, mientras que la carne toma 30 minutos. \xA1Asegurat\xE9 de echar
      agua al arroz tambi\xE9n!"
    audio: {fileID: 8300000, guid: d7f0da1917a80d24e89a6385d044ec20, type: 3}
    objectsToPoint:
