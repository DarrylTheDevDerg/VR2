--- !u!114 &1842186587
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1842186586}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 541ba21894728ab47acd7b72fca7ee3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProgressionControl
  steps:
  - instruction: "\xA1Busca el arroz en el gabinete, la carne en el congelador y
      las especias!"
    audio: {fileID: 0}
  - instruction: "\xA1Saca la olla arrocera para el arroz y el wok para la carne!"
    audio: {fileID: 0}
  - instruction: "\xA1Echa el arroz en la olla arrocera y agrega aceite, junto con
      especias! Usa una cuchara de madera limpia para mezclar."
    audio: {fileID: 0}
  - instruction: "\xA1Saca una tabla de corte y deja la carne encima para cortarla
      con el cuchillo!"
    audio: {fileID: 0}
  - instruction: "\xA1Echa los pedazos de carne dentro del wok, echandol\xE9 aceite
      y especias tambi\xE9n! Usa una cuchara de madera limpia para mezclar."
    audio: {fileID: 0}
  - instruction: "\xA1Prende el fuego para el arroz y la carne! El arroz tomar\xE1
      de 10 a 15 minutos, mientras que la carne toma de 25 a 30 minutos."
    audio: {fileID: 0}
  - instruction: "Mientras se cocina el arroz y la carne, \xA1asegurat\xE9 de que
      no se te queme ninguno de los dos! Ve echandol\xE9 agua a la carne de vez en
      cuando."
    audio: {fileID: 0}
  - instruction: "\xA1El arroz est\xE1 listo! Ahora solo falta la carne, ten cuidado
      de no diluir demasiado el jugo de este, haz un equiibrio usando el sal y las
      especias."
    audio: {fileID: 0}
  - instruction: "\xA1La carne est\xE1 lista! Saca un plato de uno de los gabinetes
      de cocina y echa all\xED el arroz junto con la carne. \xA1Que no se te olvid\xE9
      el jugo de la carne!"
    audio: {fileID: 0}
  - instruction: "\xA1Ya tienes tu plato listo! Ahora, \xA1ve y sirvelo para ver
      tu calificaci\xF3n!"
    audio: {fileID: 0}
  instructionText: {fileID: 285543145}
